{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Krita",
  "description": "Create digital paintings, illustrations and animations.",
  "version": "6.0.1",
  "image": "ghcr.io/containerpak/krita@sha256:5e50f9f72ab2f0f08a77c11f92fe4fd33b5134598ab417a98a6e83f3a0773e25",
  "binaries": [
    "/usr/bin/krita"
  ],
  "desktop_entries": [
    "/usr/share/applications/org.kde.krita.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": false,
    "socketCups": true,
    "socketGpgAgent": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": true,
    "hostApplications": false,
    "hostActions": [],
    "filesystem": [
      {
        "path": "xdg-documents",
        "access": "read-write"
      },
      {
        "path": "xdg-download",
        "access": "read-write"
      },
      {
        "path": "xdg-pictures",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
